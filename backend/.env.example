# Copia este archivo a .env y completa tus valores.

# Desarrollo local (por defecto, cero configuracion):
DATABASE_URL=sqlite:///./core.db

# Produccion / Neon / Supabase (Postgres gestionado):
# DATABASE_URL=postgresql+psycopg://usuario:password@host/dbname?sslmode=require

JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Origenes permitidos por CORS, separados por coma.
# En produccion: la URL del frontend en Cloudflare Workers.
ALLOWED_ORIGINS=http://localhost:3000
