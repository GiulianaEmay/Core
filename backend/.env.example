# Copia este archivo a .env y completa tus valores.

# Desarrollo local (por defecto, cero configuracion):
DATABASE_URL=sqlite:///./core.db

# Produccion / Neon / Supabase (Postgres gestionado):
# DATABASE_URL=postgresql+psycopg://usuario:password@host/dbname?sslmode=require

# Clerk (autenticacion). Ver Configure > API Keys en el dashboard de Clerk.
CLERK_SECRET_KEY=sk_test_...
CLERK_ISSUER=https://tu-instancia.clerk.accounts.dev

# Correos del equipo CORE que entran como admin (separados por coma).
# Si se deja vacio, el primer usuario en iniciar sesion en una base nueva es admin.
ADMIN_EMAILS=tu-correo@empresa.pe

# Origenes permitidos por CORS, separados por coma.
# En produccion: la URL del frontend en Vercel.
ALLOWED_ORIGINS=http://localhost:3100
